{
  "name": "curbside-api",
  "main": "worker.js",
  "compatibility_date": "2025-07-01",
  "kv_namespaces": [{ "binding": "AREAS", "id": "REPLACE_WITH_KV_ID" }],
  // ponytail: native Cloudflare rate limiting instead of a hand-rolled Map --
  // the endpoint is public and every request hits an undocumented upstream.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
